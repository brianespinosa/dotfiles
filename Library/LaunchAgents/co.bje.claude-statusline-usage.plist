<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Setup (one-time, after stow symlinks this file to ~/Library/LaunchAgents/):
    chmod +x ~/.claude/usage-cache.sh
    launchctl load ~/Library/LaunchAgents/co.bje.claude-statusline-usage.plist

  To unload:
    launchctl unload ~/Library/LaunchAgents/co.bje.claude-statusline-usage.plist

  Logs: /tmp/claude-statusline-usage.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>co.bje.claude-statusline-usage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bespinosa/.claude/usage-cache.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>480</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/claude-statusline-usage.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-statusline-usage.log</string>
</dict>
</plist>
