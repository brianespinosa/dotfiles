# GitHub
export GH_CONFIG_DIR=~/.config/gh/personal
export GITHUB_PAT=$(gh auth token)

# Git
export GIT_CONFIG_GLOBAL=~/.config/git/personal

# TypeSafe (key from Keychain)
# Add/rotate: security add-generic-password -a "$USER" -s typesafe-api-key -T /usr/bin/security -U -w
export TYPESAFE_API_KEY=$(security find-generic-password -a "$USER" -s typesafe-api-key -w 2>/dev/null)
